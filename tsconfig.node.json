{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src/core/**/*", "src/main/**/*", "src/preload/**/*", "src/cli/**/*", "tests/unit/**/*", "src/renderer/lib/diffRows.ts", "src/renderer/lib/hostPresets.ts", "electron.vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
